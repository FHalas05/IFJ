// 6 urovni a navrat na nulu najednou (5 DEDENTu), pak navrat doprostred
import ifj26.*
def deep(a: Int): Int =
  while a > 0 do
    while a > 1 do
      while a > 2 do
        while a > 3 do
          a = a - 1
        a = a - 1
      a = a - 1
    a = a - 1
  return a
def jump(a: Int): Int =
  if a > 0 then
    if a > 1 then
      if a > 2 then
        if a > 3 then
          return 4
        else
          return 3
      else
        return 2
    else
      return 1
  else
    return 0
@main def main(): Unit =
  val r = deep(5)
  val s = jump(r)
  print(s)
