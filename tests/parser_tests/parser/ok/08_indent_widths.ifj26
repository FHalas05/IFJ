// pocet mezer neni pevne dany: 1, 3, 5, 8, 13 mezer
import ifj26.*
def a(x: Int): Int =
 var y = x
 while y > 0 do
         y = y - 1
 return y
def b(x: Int): Int =
     if x > 0 then
      return 1
     else
             return 2
@main def main(): Unit =
   val r = a(3)
   val s = b(r)
   print(s)
