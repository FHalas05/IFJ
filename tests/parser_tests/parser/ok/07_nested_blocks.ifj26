import ifj26.*
@main def main(): Unit =
  var i = 0
  while i < 3 do
    var j = 0
    while j < 3 do
      if i == j then
        if i > 0 then
          print(i)
        else
          print(0)
      else
        print(j)
      j = j + 1
    i = i + 1
  print(i)
def last(): Unit =
  var k = 0
  while k < 2 do
    if k == 0 then
      while k < 1 do
        k = k + 1
    else
      k = k + 1
